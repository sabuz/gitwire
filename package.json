{
	"name": "gitwire",
	"version": "1.2.0",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"type-check": "tsc --noEmit",
		"lint:js": "eslint src/",
		"lint:js:fix": "eslint src/ --fix",
		"lint:scss": "wp-scripts lint-style 'src/**/*.scss'",
		"lint:scss:fix": "wp-scripts lint-style 'src/**/*.scss' --fix",
		"lint:php": "composer phpcs",
		"lint:php:fix": "composer phpcbf",
		"lint": "npm run lint:js && npm run lint:scss && npm run lint:php",
		"pre-pr-check": "npm run lint && npm run type-check && npm run build"
	},
	"devDependencies": {
		"@wordpress/dataviews": "^15.0.0",
		"@wordpress/element": "^7.0.0",
		"@wordpress/eslint-plugin": "^25.3.0",
		"@wordpress/scripts": "^32.3.0",
		"stylelint-order": "^8.1.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"sonner": "^2.0.7"
	}
}
