{
	"name": "gitwire",
	"version": "1.0.0",
	"description": "Install and update plugins and themes from GitHub, GitLab, or Bitbucket. Switch branches, and roll back automatically if an update breaks the site.",
	"private": true,
	"author": "nazsabuz",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"github",
		"gitlab",
		"git",
		"plugins",
		"themes",
		"deploy"
	],
	"homepage": "https://github.com/sabuz/gitwire",
	"repository": {
		"url": "https://github.com/sabuz/gitwire.git"
	},
	"bugs": {
		"url": "https://github.com/sabuz/gitwire/issues"
	},
	"dependencies": {
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/dataviews": "^18.0.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/eslint-plugin": "^25.9.0",
		"@wordpress/hooks": "^4.53.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/icons": "^15.4.0",
		"@wordpress/scripts": "^34.1.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"stylelint-order": "^8.1.1"
	},
	"scripts": {
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format src --ignore-path .gitignore",
		"lint": "npm run lint:js && npm run lint:scss && npm run lint:php",
		"lint:js": "wp-scripts lint-js src/ --ext .js,.jsx,.ts,.tsx",
		"lint:js:fix": "wp-scripts lint-js src/ --ext .js,.jsx,.ts,.tsx --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:php": "composer phpcs",
		"lint:php:fix": "composer phpcbf",
		"lint:phpstan": "composer phpstan",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:scss": "wp-scripts lint-style src/style.scss",
		"lint:scss:fix": "wp-scripts lint-style src/style.scss --fix",
		"licenses": "node bin/third-party-licenses.js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "bash bin/plugin-zip.sh",
		"pre-pr-check": "npm run lint && npm run lint:phpstan && npm run build",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	}
}
