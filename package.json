{
	"name": "gitwire",
	"version": "1.2.0",
	"description": "Install and manage WordPress plugins and themes directly from Git repositories.",
	"private": true,
	"author": "nazsabuz",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"github",
		"gitlab",
		"git",
		"plugins",
		"themes",
		"deploy"
	],
	"homepage": "https://github.com/sabuz/gitwire",
	"repository": {
		"url": "https://github.com/sabuz/gitwire.git"
	},
	"bugs": {
		"url": "https://github.com/sabuz/gitwire/issues"
	},
	"dependencies": {
		"sonner": "^2.0.7"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.48.0",
		"@wordpress/components": "^35.0.0",
		"@wordpress/dataviews": "^16.0.0",
		"@wordpress/element": "^8.0.0",
		"@wordpress/eslint-plugin": "^25.4.0",
		"@wordpress/i18n": "^6.21.0",
		"@wordpress/scripts": "^32.4.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"stylelint-order": "^8.1.1"
	},
	"scripts": {
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format src --ignore-path .gitignore",
		"lint": "npm run lint:js && npm run lint:scss && npm run lint:php",
		"lint:js": "wp-scripts lint-js src/ --ext .js,.jsx,.ts,.tsx",
		"lint:js:fix": "wp-scripts lint-js src/ --ext .js,.jsx,.ts,.tsx --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:php": "composer phpcs",
		"lint:php:fix": "composer phpcbf",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:scss": "wp-scripts lint-style 'src/**/*.scss'",
		"lint:scss:fix": "wp-scripts lint-style 'src/**/*.scss' --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"pre-pr-check": "npm run lint && npm run build",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	}
}
