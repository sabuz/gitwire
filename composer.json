{
	"name": "sabuz/git-for-wordpress",
	"description": "Pull GitHub and GitLab repositories directly into WordPress as plugins or themes.",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"phpcs": "./vendor/bin/phpcs --standard=phpcs.xml --extensions=php ./includes ./tests autoload.php git.php uninstall.php",
		"phpcbf": "./vendor/bin/phpcbf --standard=phpcs.xml --extensions=php ./includes ./tests autoload.php git.php uninstall.php",
		"phpunit": "./vendor/bin/phpunit -c phpunit.xml.dist",
		"update-deps": "composer update --with-dependencies",
		"check-updates": "composer outdated"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
