{
	"extends": [ "@wordpress/stylelint-config/scss-stylistic" ],
	"plugins": [ "stylelint-order" ],
	"rules": {
		"selector-class-pattern": [
			"^(?:(?:ghwp-)?[a-z0-9]+(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?|(is|has)-[a-z0-9]+(?:-[a-z0-9]+)*)$",
			{
				"message": "Use BEM-style classes (optional ghwp- prefix, __element, --modifier) or state classes: is-* / has-*"
			}
		],
		"order/properties-order": [
			[
				"all",
				"box-sizing",
				"content",
				"unicode-bidi",
				"direction",
				"position",
				"top",
				"right",
