Table gitwire_connections {
  id            varchar(64)    [primary key, note: 'e.g. pub_a1b2c3d4-e5f6-7890-abcd-ef1234567890 (public) or prv_7f3e9c1a-… (Pro private)']
  provider      varchar(32)    [not null, note: '"github" | "gitlab" | "bitbucket"']
  host_url      varchar(512)   [null, note: 'GitLab self-hosted base URL — e.g. "https://gitlab.acme.com". NULL for github.com/gitlab.com. Reserved for future Gitea support']
  identifier    varchar(255)   [not null, default: '', note: 'GitHub/GitLab: username — e.g. "nazmulsabuz". Bitbucket: workspace slug — e.g. "acme-org"']
  email         varchar(255)   [null, note: 'Bitbucket Pro only — account email used for PAT auth — e.g. "dev@acme.com". NULL otherwise']
  credentials   text           [null, note: 'NULL = public connection; encrypted JSON for Pro — e.g. {"api_token":"ghp_…"} (GitHub/GitLab) or {"email":"dev@acme.com","api_token":"ATB…"} (Bitbucket)']
  scope         varchar(16)    [not null, default: 'all', note: '"all" = site-wide; WP user ID string = user-scoped — e.g. "42"']
  authenticated tinyint(1)     [not null, default: 0, note: '1 = last credentials test passed; 0 = untested or failed. Distinct from credentials IS NOT NULL']
  error         text           [null, note: 'Last test error message — e.g. "Invalid credentials". NULL when last test passed or untested']
  name          varchar(255)   [not null, default: '', note: 'Profile display name from provider API — e.g. "Nazmul Sabuz". Empty until first credentials test']
  avatar_url    varchar(512)   [not null, default: '', note: 'Profile avatar URL — e.g. "https://avatars.githubusercontent.com/u/123456". Empty until first test']
  rate_limit     int           [not null, default: 0, note: 'API rate limit ceiling — e.g. 5000 (GitHub authenticated). 0 until first test']
  rate_remaining int           [not null, default: 0, note: 'Remaining API calls in the current window — e.g. 4982. 0 until first test']
  rate_reset     int           [not null, default: 0, note: 'Unix timestamp when the rate-limit window resets — e.g. 1741946400. 0 until first test']
  created_at    datetime       [not null, note: 'e.g. 2025-03-14 09:00:00']
  updated_at    datetime       [not null, note: 'Last profile cache write — e.g. 2025-03-20 11:30:00. Returned to JS as checked_at (Unix int via strtotime)']

  indexes {
    provider
  }
}

Table gitwire_installations {
  id           bigint       [pk, increment]
  connection_id varchar(64) [not null, default: '', note: 'FK → gitwire_connections.id. Empty string for URL-based installs']
  provider     varchar(32)  [not null, note: '"github" | "gitlab" | "bitbucket"']
  owner        varchar(255) [not null, default: '', note: 'e.g. "nazmulsabuz"']
  name         varchar(255) [not null, default: '', note: 'e.g. "fit-assistant"']
  full_name    varchar(255) [not null, default: '', note: 'e.g. "nazmulsabuz/fit-assistant"']
  html_url     varchar(512) [not null, default: '', note: 'Repository URL on the provider — e.g. "https://github.com/nazmulsabuz/fit-assistant". Populated from gitwire_repositories at install time']
  type         varchar(16)  [not null, default: 'plugin', note: '"plugin" | "block-theme" | "classic-theme"']
  install_path varchar(1024) [not null, default: '', note: 'Absolute server path — e.g. "/var/www/html/wp-content/plugins/fit-assistant"']
  basename     varchar(512) [null, note: 'plugin_basename() value — e.g. "fit-assistant/fit-assistant.php". NULL for theme installations. Used for is_plugin_active(), deactivate_plugins(), and the deleted_plugin hook']
  branch       varchar(255) [not null, default: 'main', note: 'e.g. "main" or "trunk"']
  auto_update  varchar(16)  [not null, default: 'disabled', note: '"disabled" = manual only; "current" = branch-locked (same branch); "any" = always update']
  head         varchar(64)  [not null, default: '', note: 'Installed commit SHA — e.g. "a3f8c1d2e4b56789012345678901234567890abc". 64 chars to accommodate future SHA-256 object IDs']
  remote_head  varchar(64)  [not null, default: '', note: 'Latest remote commit SHA; differs from head when an update is available']
  updated_at   datetime     [not null, note: 'e.g. 2025-03-20 11:30:00']

  indexes {
    (provider, full_name) [unique]
    connection_id
    (connection_id, type)
    auto_update
  }
}

Table gitwire_commits {
  installation_id bigint       [not null, note: 'FK → gitwire_installations.id']
  branch          varchar(255) [not null, default: 'main', note: 'e.g. "main"']
  data            mediumtext   [not null, note: 'JSON array from provider API — e.g. [{"sha":"a3f8c1d…","message":"Fix size chart layout","date":"2025-03-20T11:00:00Z","author":"nazmulsabuz"}]']
  updated_at      datetime     [not null, note: 'Last time this cache was refreshed — e.g. 2025-03-20 11:30:00']

  indexes {
    (installation_id, branch) [pk]
  }
}

Table gitwire_repositories {
  connection_id    varchar(64)  [not null, note: 'FK → gitwire_connections.id']
  provider         varchar(32)  [not null, note: '"github" | "gitlab" | "bitbucket"']
  owner            varchar(255) [not null, default: '', note: 'e.g. "nazmulsabuz"']
  name             varchar(255) [not null, default: '', note: 'e.g. "fit-assistant"']
  full_name        varchar(255) [not null, default: '', note: 'e.g. "nazmulsabuz/fit-assistant"']
  html_url         varchar(512) [not null, default: '', note: 'e.g. "https://github.com/nazmulsabuz/fit-assistant"']
  private          tinyint(1)   [not null, default: 0, note: '0 = public, 1 = private']
  type             varchar(16)  [not null, default: '', note: 'Detection result: "plugin" | "block-theme" | "classic-theme" | "unknown" | "" (not yet detected)']
  type_meta        text         [null, note: 'Detection payload JSON — e.g. {"confidence":"high","name":"Fit Assistant","key_files":["fit-assistant.php"]}']
  default_branch   varchar(255) [not null, default: 'main', note: 'e.g. "main" or "master"']
  last_activity_at datetime     [not null, default: '1970-01-01 00:00:00', note: 'Last push/activity from provider API — e.g. 2025-03-18 14:22:00']
  updated_at       datetime     [not null, note: 'Last time this row was refreshed by cron — e.g. 2025-03-20 11:00:00']

  indexes {
    (connection_id, full_name) [pk]
    (provider, full_name)
    type
    (connection_id, last_activity_at)
  }
}

Ref conn_installations: gitwire_installations.connection_id    > gitwire_connections.id
Ref installation_commits: gitwire_commits.installation_id      > gitwire_installations.id
Ref conn_repositories:  gitwire_repositories.connection_id     > gitwire_connections.id
