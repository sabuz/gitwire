includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80000
	bootstrapFiles:
		- phpstan-stubs.php
	paths:
		- includes
		- tests
		- autoload.php
		- gitwire.php
		- uninstall.php
	excludePaths:
		- vendor/*
		# These files redeclare WordPress functions already defined by the stub package.
		- tests/bootstrap.php
		- tests/stubs.php
		- tests/class-wp-error.php
		- tests/class-fake-wpdb.php
		# This file shadows DNS functions inside the Gitwire namespace.
		- tests/dns-stubs.php
	# Read symbols such as test helpers and sandbox constants without analysing bodies.
	scanFiles:
		- tests/bootstrap.php
		- tests/stubs.php
		- tests/class-fake-wpdb.php
	dynamicConstantNames:
		- AUTH_COOKIE
		- LOGGED_IN_COOKIE
