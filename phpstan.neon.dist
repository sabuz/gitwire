includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80200
	bootstrapFiles:
		- phpstan-stubs.php
	paths:
		- includes
		- tests
		- autoload.php
		- gitwire.php
		- uninstall.php
	excludePaths:
		- vendor/*
		# both redeclare WP functions that the WordPress stub package already defines
		- tests/bootstrap.php
		- tests/stubs.php
		- tests/class-wp-error.php
		- tests/class-fake-wpdb.php
	# read for symbols (test helpers, sandbox constants) without analysing the bodies
	scanFiles:
		- tests/bootstrap.php
		- tests/stubs.php
		- tests/class-fake-wpdb.php
	dynamicConstantNames:
		- AUTH_COOKIE
		- LOGGED_IN_COOKIE
